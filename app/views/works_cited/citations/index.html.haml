= stylesheet_link_tag 'works_cited/application'
%h1 Listing citations

= link_to 'New Citation', new_citation_path
%table.table-data
  %tr
    %th Citation Type
    %th Title
    %th Authors
    %th{colspan: 3}
  - @citations.each do |citation|
    %tr
      %td= citation.citation_type
      %td= citation.title
      %td= list_names(citation.works_cited_contributors.authors)
      %td= link_to 'Show', citation, class: 'button button-link'
      %td= link_to 'Edit', edit_citation_path(citation), class: 'button button-action'
      %td= link_to 'Destroy', citation, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'button button-danger'
= paginate @citations